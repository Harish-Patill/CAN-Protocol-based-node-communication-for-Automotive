text0 0 2D8E 2D8E 224 1
text1 0 2840 2840 36 1
text2 0 27CE 27CE 18 1
text3 0 2C4C 2C4C 9E 1
text4 0 2B48 2B48 74 1
text5 0 27B8 27B8 16 1
text6 0 2820 2820 20 1
text7 0 27B0 27B0 8 1
text8 0 28B2 28B2 3C 1
text9 0 27E6 27E6 1C 1
text10 0 2A6C 2A6C 6A 1
text11 0 2A02 2A02 6A 1
text12 0 28EE 28EE 46 1
text13 0 2998 2998 6A 1
text14 0 2CEA 2CEA A4 1
text15 0 2BBC 2BBC 90 1
text16 0 2876 2876 3C 1
text17 0 2934 2934 64 1
text18 0 2AD6 2AD6 72 1
cstackCOMRAM 1 1 1 2B 1
